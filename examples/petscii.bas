10 REM *** PETSCII DEMO (browser terminal) ***
20 CLS: POKE 53281, 0: POKE 53280, 6
30 COLOR 7: PRINT "      PETSCII GRAPHICS AND COLOURS"
40 COLOR 1: PRINT
50 REM --- a frame made of line graphics ---
60 PRINT CHR$(176); : FOR I = 1 TO 38: PRINT CHR$(192);: NEXT I: PRINT CHR$(174)
70 FOR R = 1 TO 4
80 PRINT CHR$(221); : PRINT SPACE$(38); : PRINT CHR$(221)
90 NEXT R
100 PRINT CHR$(173); : FOR I = 1 TO 38: PRINT CHR$(192);: NEXT I: PRINT CHR$(189)
110 LOCATE 5, 4: COLOR 13: PRINT "HELLO FROM THE 40 X 25 SCREEN!"
120 LOCATE 6, 4: COLOR 3: PRINT CHR$(18); " REVERSE "; CHR$(146); "  AND NORMAL"
130 LOCATE 7, 4: COLOR 10: PRINT "CARDS: ";
140 PRINT CHR$(193); " "; CHR$(211); " "; CHR$(216); " "; CHR$(218)
170 REM --- the 16 colours ---
180 LOCATE 9, 1: COLOR 1: PRINT "THE 16 C64 COLOURS:"
190 FOR C = 0 TO 15
200 COLOR C: PRINT CHR$(18); " "; CHR$(146);
210 NEXT C
220 PRINT
230 REM --- the graphics character set ---
240 LOCATE 12, 1: COLOR 1: PRINT "GRAPHICS CODES 160-191:"
250 COLOR 12
260 FOR C = 160 TO 191: PRINT CHR$(C);: NEXT C
270 PRINT
280 PRINT "CODES 192-223:"
290 FOR C = 192 TO 223: PRINT CHR$(C);: NEXT C
300 PRINT
310 REM --- poke straight into screen memory ---
320 FOR I = 0 TO 39
330 POKE 1024 + 23 * 40 + I, 160 - 96 + (I MOD 32)
340 POKE 55296 + 23 * 40 + I, 2 + (I MOD 14)
350 NEXT I
360 LOCATE 25, 1: COLOR 1: PRINT "PRESS ANY KEY";
370 IF INKEY$ = "" THEN SLEEP 50: GOTO 370
380 POKE 53280, 17: POKE 53281, 17: COLOR 16: CLS
