10 REM *** SPACE INVADERS (real time, browser terminal) ***
20 W=30: H=14: SR=H-4: HI=0
25 T$="+": FOR I=1 TO W: T$=T$+"-": NEXT I: T$=T$+"+"
30 CLS: PRINT "SPACE INVADERS": PRINT
40 PRINT "  A / Left arrow   move left"
50 PRINT "  D / Right arrow  move right"
60 PRINT "  Space            fire"
70 PRINT "  Q                quit"
75 PRINT: PRINT "Hold a key to keep moving. Release it to stop."
80 PRINT: INPUT "Press Enter to start"; Z$
90 SC=0: LV=3: WV=1
100 REM --- new wave ---
110 DIM IV(3,6), MX(4), MY(4), SH(1,29)
120 FOR R=1 TO 3: FOR C=1 TO 6: IV(R,C)=1: NEXT C: NEXT R
130 AL=18: OX=0: OY=WV: IF OY>4 THEN OY=4
140 DX=1: PX=W/2: BX=0: BY=-1: FR=0: HM=0
150 FOR K=1 TO 3: MY(K)=-1: NEXT K
160 FOR B=0 TO 3: FOR I=0 TO 4
162 SH(0,3+B*7+I)=3
164 IF I<>2 THEN SH(1,3+B*7+I)=3
166 NEXT I: NEXT B
200 REM --- main loop: one frame per pass ---
210 GOSUB 2000
220 SLEEP 50
230 K$=UCASE$(INKEY$): IF K$="Q" THEN 9000
240 IF (KEYDOWN(65) OR KEYDOWN(37)) AND PX>0 THEN PX=PX-1
250 IF (KEYDOWN(68) OR KEYDOWN(39)) AND PX<W-1 THEN PX=PX+1
260 IF KEYDOWN(32) AND BY<0 THEN BX=PX: BY=H
300 REM --- player bullet: 2 cells per frame ---
310 FOR S=1 TO 2: IF BY>=0 THEN BY=BY-1: GOSUB 1100
320 NEXT S
400 REM --- enemy bombs: 1 cell per frame ---
410 FOR K=1 TO 3: IF MY(K)>=0 THEN MY(K)=MY(K)+1: GOSUB 1200
420 NEXT K
430 IF HM>0 THEN HM=HM-1
500 REM --- invaders drop a bomb ---
510 IF RND(1)>0.04 THEN 600
520 C=INT(RND(1)*6)+1
530 R=3: WHILE R>0 AND IV(R,C)=0: R=R-1: WEND
540 IF R=0 THEN 600
550 K=1: WHILE K<=3 AND MY(K)>=0: K=K+1: WEND
560 IF K>3 THEN 600
570 MX(K)=OX+(C-1)*3: MY(K)=OY+(R-1)*2+1
600 REM --- invaders march (faster as fewer are left) ---
610 FR=FR+1: SP=INT(AL/2)+3-WV: IF SP<3 THEN SP=3
620 IF FR MOD SP<>0 THEN 700
630 OX=OX+2*DX
640 IF OX>14 THEN OX=14: DX=-1: OY=OY+1
650 IF OX<0 THEN OX=0: DX=1: OY=OY+1
660 GOSUB 1100
665 GOSUB 1500
700 REM --- check state ---
710 IF AL=0 THEN 8000
720 IF LV<=0 THEN 9100
730 LR=0: FOR R=1 TO 3: FOR C=1 TO 6: IF IV(R,C)=1 THEN LR=R
750 NEXT C: NEXT R
760 IF OY+(LR-1)*2>=H THEN 9200
770 GOTO 210
1000 REM --- which invader is at GX,GY? result in R,C (0 = none) ---
1001 R=0: C=0
1010 IF GY<OY OR GX<OX THEN RETURN
1020 IF (GY-OY) MOD 2<>0 THEN RETURN
1030 IF (GX-OX) MOD 3<>0 THEN RETURN
1040 R=(GY-OY)/2+1: C=(GX-OX)/3+1
1050 IF R>3 OR C>6 THEN R=0: C=0: RETURN
1060 IF IV(R,C)=0 THEN R=0: C=0
1070 RETURN
1100 REM --- did the bullet hit an invader? ---
1110 IF BY<0 THEN RETURN
1115 GX=BX: GY=BY: GOSUB 1400
1116 IF HT=1 THEN BY=-1: RETURN
1120 GX=BX: GY=BY: GOSUB 1000
1130 IF R=0 THEN RETURN
1140 IV(R,C)=0: AL=AL-1: SC=SC+10*(4-R): BY=-1
1150 RETURN
1200 REM --- bomb K moved: hit a barricade, or reached the player row? ---
1202 GX=MX(K): GY=MY(K): GOSUB 1400
1204 IF HT=1 THEN MY(K)=-1: RETURN
1210 IF MY(K)<H THEN RETURN
1220 IF MX(K)=PX THEN LV=LV-1: HM=15
1230 MY(K)=-1
1240 RETURN
1400 REM --- barricade cell at GX,GY? erode it. HT=1 if hit ---
1401 HT=0
1410 IF GY<SR OR GY>SR+1 THEN RETURN
1420 IF SH(GY-SR,GX)=0 THEN RETURN
1430 SH(GY-SR,GX)=SH(GY-SR,GX)-1: HT=1
1440 RETURN
1500 REM --- invaders trample the barricades they touch ---
1510 FOR Y=0 TO 1: FOR X=0 TO W-1: IF SH(Y,X)>0 THEN GX=X: GY=SR+Y: GOSUB 1000: IF R>0 THEN SH(Y,X)=0
1520 NEXT X: NEXT Y
1530 RETURN
2000 REM --- draw the screen ---
2001 CLS: PRINT "SCORE "; SC; "   HI "; HI; "   LIVES "; LV; "   WAVE "; WV;
2002 IF HM>0 THEN PRINT "   *** HIT! ***": GOTO 2010
2003 PRINT
2010 PRINT T$
2020 FOR RY=0 TO H
2030 S$="|"
2040 FOR RX=0 TO W-1
2050 GOSUB 2200
2060 S$=S$+CH$
2070 NEXT RX
2080 PRINT S$+"|"
2090 NEXT RY
2100 PRINT T$: RETURN
2200 CH$=" "
2210 IF RY=H AND RX=PX THEN CH$="┴": RETURN
2220 IF BY>=0 AND RX=BX AND RY=BY THEN CH$="│": RETURN
2230 FOR K=1 TO 3: IF MY(K)=RY AND MX(K)=RX THEN CH$="○"
2240 NEXT K
2250 IF CH$="○" THEN RETURN
2255 IF RY>=SR AND RY<=SR+1 THEN IF SH(RY-SR,RX)>0 THEN CH$=MID$("▖▒█",SH(RY-SR,RX),1): RETURN
2260 GX=RX: GY=RY: GOSUB 1000
2270 IF R=1 THEN CH$="♠"
2272 IF R=2 THEN CH$="♣"
2274 IF R=3 THEN CH$="♦"
2280 RETURN
8000 CLS: PRINT "*** WAVE "; WV; " CLEARED! ***": SC=SC+100: WV=WV+1
8010 SLEEP 1500
8020 GOTO 100
9000 PRINT: PRINT "Bye!": END
9100 GOSUB 2000: PRINT: PRINT "*** GAME OVER ***": GOTO 9300
9200 GOSUB 2000: PRINT: PRINT "*** THE INVADERS HAVE LANDED! ***"
9300 IF SC>HI THEN HI=SC: PRINT "NEW HIGH SCORE!"
9310 PRINT "Final score: "; SC
9320 INPUT "Play again (Y/N)"; Z$
9330 IF UCASE$(Z$)="Y" THEN 90
9340 END
