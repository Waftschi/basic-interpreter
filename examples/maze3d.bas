10 REM *** 3D MAZE *** W/S step, A/D turn, Q quit. Needs the browser terminal (INKEY$).
20 DIM M$(10), G$(14), DX(3), DY(3), LS(6), RS(6)
25 SP$=SPACE$(29)
30 FOR I=0 TO 10: READ M$(I): NEXT I
40 FOR I=0 TO 3: READ DX(I), DY(I): NEXT I
50 AR$="^>v<"
60 PX=1: PY=1: D=1: MX=13: MY=1: ST=0
70 GOSUB 2000
100 K$=INKEY$: IF K$="" THEN SLEEP 40: GOTO 100
110 K$=UCASE$(K$)
120 IF K$="Q" THEN 9000
130 IF K$="A" THEN D=(D+3) MOD 4: GOSUB 2000: GOTO 100
140 IF K$="D" THEN D=(D+1) MOD 4: GOSUB 2000: GOTO 100
150 IF K$="W" THEN FD=D: GOTO 300
160 IF K$="S" THEN FD=(D+2) MOD 4: GOTO 300
170 GOTO 100
300 REM --- step in direction FD ---
310 TX=PX+DX(FD): TY=PY+DY(FD): GOSUB 1900
320 IF WL=1 THEN 100
330 PX=TX: PY=TY: ST=ST+1
340 IF MID$(M$(PY),PX+1,1)="E" THEN 8000
350 IF ST>5 AND ST MOD 2=0 THEN GOSUB 1500
360 IF MX=PX AND MY=PY THEN 8100
370 GOSUB 2000: GOTO 100
1500 REM --- the monster takes a step towards you ---
1510 IF RND(1)<0.3 THEN 1560
1520 A1=SGN(PX-MX): A2=SGN(PY-MY)
1530 IF ABS(PX-MX)<ABS(PY-MY) THEN 1545
1535 TX=MX+A1: TY=MY: IF A1<>0 THEN GOSUB 1900: IF WL=0 THEN MX=TX: RETURN
1545 TX=MX: TY=MY+A2: IF A2<>0 THEN GOSUB 1900: IF WL=0 THEN MY=TY: RETURN
1550 IF ABS(PX-MX)<ABS(PY-MY) THEN TX=MX+A1: TY=MY: IF A1<>0 THEN GOSUB 1900: IF WL=0 THEN MX=TX: RETURN
1560 R=INT(RND(1)*4): TX=MX+DX(R): TY=MY+DY(R): GOSUB 1900
1570 IF WL=0 THEN MX=TX: MY=TY
1580 RETURN
1900 REM --- is cell TX,TY a wall? WL=1 if so ---
1901 WL=0: IF TX<0 OR TX>14 OR TY<0 OR TY>10 THEN WL=1: RETURN
1910 IF MID$(M$(TY),TX+1,1)="#" THEN WL=1
1920 RETURN
1950 G$(YY)=LEFT$(G$(YY),XX)+CC$+MID$(G$(YY),XX+2): RETURN
1960 FOR VY=V1 TO V2: YY=VY: XX=VX: CC$="│": GOSUB 1950: NEXT VY: RETURN
2000 REM --- draw the view as a wire frame, with the map beside it ---
2001 CLS
2005 FOR Y=0 TO 14: G$(Y)=SP$: NEXT Y
2010 F=6: LD=(D+3) MOD 4: RD=(D+1) MOD 4
2020 FOR J=0 TO 5
2030 TX=PX+DX(D)*(J+1): TY=PY+DY(D)*(J+1): GOSUB 1900
2040 IF WL=1 THEN F=J: J=5
2050 NEXT J
2060 JM=F: IF JM>5 THEN JM=5
2070 FOR J=0 TO JM
2080 CX=PX+DX(D)*J: CY=PY+DY(D)*J
2090 TX=CX+DX(LD): TY=CY+DY(LD): GOSUB 1900: LS(J)=WL
2100 TX=CX+DX(RD): TY=CY+DY(RD): GOSUB 1900: RS(J)=WL
2110 NEXT J
2120 KM=JM: IF F=6 THEN KM=6: LS(6)=0: RS(6)=0
2130 FOR K=1 TO KM
2140 IF LS(K)<>LS(K-1) THEN VX=K: V1=K: V2=14-K: GOSUB 1960
2150 IF RS(K)<>RS(K-1) THEN VX=28-K: V1=K: V2=14-K: GOSUB 1960
2160 NEXT K
2170 FOR J=0 TO JM
2180 IF LS(J)=1 THEN XX=J: YY=J: CC$="╲": GOSUB 1950: YY=14-J: CC$="╱": GOSUB 1950
2190 IF RS(J)=1 THEN XX=28-J: YY=J: CC$="╱": GOSUB 1950: YY=14-J: CC$="╲": GOSUB 1950
2200 NEXT J
2210 IF F>5 THEN 2300
2220 K=F+1: CC$="─"
2230 FOR XX=K+1 TO 27-K: YY=K: GOSUB 1950: YY=14-K: GOSUB 1950: NEXT XX
2240 VX=K: V1=K+1: V2=13-K: GOSUB 1960
2250 VX=28-K: GOSUB 1960
2260 CC$="┌": YY=K: XX=K: GOSUB 1950: CC$="┐": XX=28-K: GOSUB 1950: CC$="┘": YY=14-K: GOSUB 1950: CC$="└": XX=K: GOSUB 1950
2300 FOR MM=1 TO 5
2310 IF MM<=F AND MX=PX+DX(D)*MM AND MY=PY+DY(D)*MM THEN GOSUB 2600
2320 NEXT MM
2430 PRINT "3D MAZE   find the exit E, avoid the monster"
2440 FOR Y=0 TO 14
2450 S$=G$(Y)
2460 IF Y<=10 THEN GOSUB 2800
2470 PRINT S$
2480 NEXT Y
2490 PRINT "W/S step   A/D turn   Q quit      steps "; ST
2500 RETURN
2600 HX=INT(8/(MM+0.5)): HY=INT(6/(MM+0.5))
2610 FOR XX=14-HX TO 14+HX: CC$="─": YY=7-HY: GOSUB 1950: YY=7+HY: GOSUB 1950: NEXT XX
2620 FOR YY=7-HY TO 7+HY: CC$="│": XX=14-HX: GOSUB 1950: XX=14+HX: GOSUB 1950: NEXT YY
2630 CC$="┌": XX=14-HX: YY=7-HY: GOSUB 1950: CC$="┐": XX=14+HX: GOSUB 1950
2640 CC$="┘": YY=7+HY: GOSUB 1950: CC$="└": XX=14-HX: GOSUB 1950
2650 CC$="●": YY=7+(HY>=2): XX=14-INT(HX/2): GOSUB 1950: XX=14+INT(HX/2): GOSUB 1950
2660 RETURN
2800 R$=M$(Y)
2810 IF Y=MY AND ABS(MX-PX)+ABS(MY-PY)<7 THEN R$=LEFT$(R$,MX)+"M"+MID$(R$,MX+2)
2820 IF Y=PY THEN R$=LEFT$(R$,PX)+MID$(AR$,D+1,1)+MID$(R$,PX+2)
2830 S$=S$+"  "+R$
2840 RETURN
8000 PRINT: PRINT "*** YOU ESCAPED in "; ST; " steps! ***": END
8100 GOSUB 2000: PRINT: PRINT "*** THE MONSTER GOT YOU! ***": END
9000 PRINT "Bye!": END
9100 DATA "###############"
9110 DATA "#S  #     #   #"
9120 DATA "# # # ### # # #"
9130 DATA "# #   #   # # #"
9140 DATA "# ##### ### # #"
9150 DATA "#       #   # #"
9160 DATA "##### ### ### #"
9170 DATA "#   #   #     #"
9180 DATA "# # ### # ### #"
9190 DATA "# #     #   #E#"
9200 DATA "###############"
9210 DATA 0,-1,1,0,0,1,-1,0
